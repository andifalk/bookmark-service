@startuml
left to right direction
skinparam componentStyle rectangle

package "Service Layer" {
  [BookmarkService] as bookmarkService
  [UserService] as userService
  [BookmarkUserDetailsService] as uds
}

package "Data Layer" {
  [BookmarkEntityRepository] as ber
  [CustomBookmarkEntityRepository] as cber
  [UserEntityRepository] as uer
  [CustomUserEntityRepository] as cuer
}

bookmarkService --> ber
bookmarkService --> cber
bookmarkService --> "EntityManager/Hibernate"
userService --> uer
userService --> cuer
uds --> userService
@enduml
