@startuml
actor Client
participant "BookmarkRestController" as Controller
participant "BookmarkService" as Service
participant "BookmarkEntityRepository" as Repo
database "H2" as DB

Client -> Controller : POST /api/bookmarks/upload (multipart file)
Controller -> Service : importBookmarks(file)
Service -> Service : parse XLSX via Apache POI
loop each data row
  Service -> Repo : save(BookmarkEntity)
  Repo -> DB : INSERT
  DB --> Repo : persisted row
end
Service --> Controller : persisted bookmarks
Controller --> Client : 200 OK + JSON
@enduml
